# Dummy local credentials. Copy to .env if you want to override the Compose defaults.
# Never put real cloud keys here.

POSTGRES_USER=cc0
POSTGRES_PASSWORD=cc0_local_password
POSTGRES_DB=cc0
POSTGRES_PORT=5432

RUSTFS_ACCESS_KEY=cc0rustfs
RUSTFS_SECRET_KEY=cc0rustfs_local_password
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
S3_BUCKET=cc0

# API process. If POSTGRES_PORT changes, change the host port in these URLs too.
# Migrations run as the database superuser. The API and worker use their own logins.
APP_ENV=local
MIGRATION_DATABASE_URL=postgresql://cc0:cc0_local_password@127.0.0.1:5432/cc0
DATABASE_URL=postgresql://cc0_api:cc0_api_local_password@127.0.0.1:5432/cc0
WORKER_DATABASE_URL=postgresql://cc0_worker:cc0_worker_local_password@127.0.0.1:5432/cc0
CC0_MIGRATOR_PASSWORD=cc0_migrator_local_password
CC0_API_PASSWORD=cc0_api_local_password
CC0_WORKER_PASSWORD=cc0_worker_local_password
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_BUCKET=cc0
OBJECT_STORE_ACCESS_KEY=cc0rustfs
OBJECT_STORE_SECRET_KEY=cc0rustfs_local_password
OBJECT_STORE_REGION=us-east-1
API_PORT=8000
