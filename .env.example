# Dummy local credentials. Copy to .env if you want to override the Compose defaults.
# Never put real cloud keys here.

POSTGRES_USER=cc0
POSTGRES_PASSWORD=cc0_local_password
POSTGRES_DB=cc0
POSTGRES_PORT=5432

RUSTFS_ACCESS_KEY=cc0rustfs
RUSTFS_SECRET_KEY=cc0rustfs_local_password
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
S3_BUCKET=cc0

# Host-run API process. If POSTGRES_PORT changes, change these host URLs too.
# Compose replaces the URL hosts and object-store endpoint with service DNS names.
# Migrations run as the database superuser. The API and worker use their own logins.
APP_ENV=local
MIGRATION_DATABASE_URL=postgresql://cc0:cc0_local_password@127.0.0.1:5432/cc0
DATABASE_URL=postgresql://cc0_api:cc0_api_local_password@127.0.0.1:5432/cc0
WORKER_DATABASE_URL=postgresql://cc0_worker:cc0_worker_local_password@127.0.0.1:5432/cc0
CC0_MIGRATOR_PASSWORD=cc0_migrator_local_password
CC0_API_PASSWORD=cc0_api_local_password
CC0_WORKER_PASSWORD=cc0_worker_local_password
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_BUCKET=cc0
OBJECT_STORE_ACCESS_KEY=cc0rustfs
OBJECT_STORE_SECRET_KEY=cc0rustfs_local_password
OBJECT_STORE_REGION=us-east-1
API_PORT=8000

# Ingestion worker. `fixture` replays the recorded catalog in
# backend/fixtures/met and opens no socket; `network` is the opt-in live mode.
# These limits are protective defaults, not provider claims. Lowering them is
# always safe; raising them needs a reason.
INGEST_SOURCE_MODE=fixture
INGEST_FIXTURE_DIR=backend/fixtures/met
INGEST_BATCH_LIMIT=100
INGEST_RATE_LIMIT_RPS=1.0
INGEST_REQUEST_TIMEOUT_SECONDS=10.0
INGEST_MAX_IMAGE_BYTES=10485760
INGEST_MAX_REDIRECTS=3
INGEST_MAX_IMAGE_PIXELS=50000000
INGEST_THUMBNAIL_MAX_PIXELS=512
# One initial attempt plus three retries, then the job dead-letters.
INGEST_MAX_ATTEMPTS=4
INGEST_BACKOFF_BASE_SECONDS=2.0
INGEST_BACKOFF_MAX_SECONDS=300.0
INGEST_LEASE_SECONDS=300
# How long one attempt may keep renewing that lease before it gives up.
INGEST_JOB_DEADLINE_SECONDS=900
# Negative-cache recheck policy, in days.
INGEST_RECHECK_UNKNOWN_DAYS=7
INGEST_RECHECK_NON_CC0_DAYS=30
# Host allowlists. Metadata and image bytes are deliberately separate.
INGEST_METADATA_HOSTS=collectionapi.metmuseum.org
INGEST_IMAGE_HOSTS=images.metmuseum.org

# Embeddings. `fake` is deterministic and is what tests run. `openclip` loads a
# ViT-B checkpoint named by MODEL_KEY and MODEL_VERSION. Leave MODEL_VERSION
# as `unpinned` until a checkpoint is chosen; OpenCLIP then refuses to download
# weights. The column is vector(512). Weights cache outside the git repo.
EMBEDDING_PROVIDER=fake
MODEL_KEY=ViT-B-32
MODEL_VERSION=unpinned
MODEL_DIMENSIONS=512
EMBEDDING_CACHE_DIR=backend/.cache/embeddings

# Optional API-only selector for stored image vectors used by related works and
# board recommendations. Set both to an existing embedding identity. This does
# not load OpenCLIP or change text search's inference provider.
# CATALOG_EMBEDDING_MODEL_KEY=ViT-B-32
# CATALOG_EMBEDDING_MODEL_VERSION=laion2b_s34b_b79k

# Board recommendation strategy per mode. The complement default is an
# experimental control, not a final complement algorithm. See
# docs/systems/recommendations.md for the registered names.
RECOMMENDER_COHESIVE_STRATEGY=centroid-cosine
RECOMMENDER_COMPLEMENT_STRATEGY=complement-baseline-v0

# M3 local board authentication (opt in; keep the signing key private).
# APP_ENV=local must be explicitly configured when AUTH_MODE=local.
# AUTH_MODE=local
# AUTH_LOCAL_SIGNING_KEY=<generate a random key of at least 32 bytes>

# Required by the API in every environment, independent of database and auth keys.
# Generate once with `openssl rand -hex 32`; keep the same value on every API replica.
# CURSOR_SIGNING_KEY=<64 random hex digits; do not commit the value>
